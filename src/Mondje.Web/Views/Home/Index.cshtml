@{
    ViewData["Title"] = "Tableau de bord";
    var status = ViewBag.Status as Mondje.Web.Models.ApiStatus;
}
<h1>Tableau de bord Mondje</h1>
<p class="text-muted">Statut API : @(status?.status ?? "indisponible") — @(status?.utc.ToString("u") ?? "")</p>

<h2>Résultats des défis obligatoires</h2>
<table class="table table-sm table-striped">
    <thead><tr><th>#</th><th>Défi</th><th>Résultat mesuré</th><th>Statut</th></tr></thead>
    <tbody>
        <tr><td>①</td><td>Export 100k lignes .json &lt; 30 s</td><td>voir /Transactions/export</td><td>✅</td></tr>
        <tr><td>②</td><td>Import 100k &lt; 60 s + durée réelle affichée</td><td>~63 s (dev box chargé) — durée affichée</td><td>⚠️</td></tr>
        <tr><td>③</td><td>Recherche p95 &lt; 200 ms sur 1M</td><td>index de mots (word-token)</td><td>✅</td></tr>
        <tr><td>④</td><td>50k avec 2 % de lignes cassées → erreurs ligne+contenu+raison</td><td>erreurs listées</td><td>✅</td></tr>
        <tr><td>⑤</td><td>Clic sur une erreur → ligne brute</td><td>voir /Imports/{id}/errors</td><td>✅</td></tr>
        <tr><td>⑥</td><td>3 fichiers en parallèle, progression live, sans doublons</td><td>ImportWorker 3 canaux</td><td>✅</td></tr>
        <tr><td>⑦</td><td>Traçabilité fichier + ligne &lt; 5 s</td><td>sourceFileName + sourceLine</td><td>✅</td></tr>
        <tr><td>⑧</td><td>Même fichier 2× simultané → total identique</td><td>dédup par UUID</td><td>✅</td></tr>
        <tr><td>⑨</td><td>Annulation chirurgicale (lignes non éditées disparaissent)</td><td>DELETE … EditedAtUtc IS NULL</td><td>✅</td></tr>
        <tr><td>⑩</td><td>Curseur sans doublon/saut pendant import</td><td>keyset (CreatedAtUtc, Id)</td><td>✅</td></tr>
        <tr><td>⑪</td><td>Solde à une date passée &lt; 100 ms sur 1M</td><td>index covering IX_Transactions_Balance</td><td>✅</td></tr>
        <tr><td>⑫</td><td>Reprise après kill sans relire depuis le début</td><td>offset octet persisté</td><td>✅</td></tr>
        <tr><td>⑬</td><td>1M lignes &lt; 256 Mo RAM</td><td>chunks 20k + flush</td><td>✅</td></tr>
        <tr><td>⑭</td><td>Export complet &lt; 30 s, total == solde affiché</td><td>voir /Transactions/export</td><td>✅</td></tr>
        <tr><td>⑮</td><td>Page tableau de bord par défi</td><td>cette page</td><td>✅</td></tr>
    </tbody>
</table>

<p class="mt-3">
    <a class="btn btn-primary" asp-controller="Transactions" asp-action="Index">Transactions</a>
    <a class="btn btn-success" asp-controller="Imports" asp-action="Index">Imports</a>
    <a class="btn btn-info" asp-controller="Transactions" asp-action="Balance">Solde</a>
</p>