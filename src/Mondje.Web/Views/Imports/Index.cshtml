@model Mondje.Web.Models.ImportListResponse
@{
    ViewData["Title"] = "Imports";
    var cursor = Context.Request.Query["cursor"].ToString();
}
<h1>Imports</h1>
<form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 mb-3">
    @Html.AntiForgeryToken()
    <div class="col-md-5"><input type="file" name="file" class="form-control" accept=".txt,.ndjson,.json" /></div>
    <div class="col-md-3">
        <select name="agency" class="form-select">
            <option value="">Agence (optionnel)</option>
            <option value="Douala">Douala</option>
            <option value="Yaoundé">Yaoundé</option>
            <option value="Bafoussam">Bafoussam</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-success" type="submit">Importer</button></div>
</form>

@if (Model is null)
{
    <div class="alert alert-warning">API indisponible.</div>
}
else
{
    <table class="table table-sm table-striped">
        <thead><tr><th>Fichier</th><th>Format</th><th>Statut</th><th>Progression</th><th>Insérées</th><th>Doublons</th><th>Erreurs</th><th>Durée</th><th></th></tr></thead>
        <tbody>
        @foreach (var i in Model.items)
        {
            <tr>
                <td>@i.fileName</td>
                <td>@i.format</td>
                <td>@i.status</td>
                <td>@i.progressPercent % (@i.processedLines/@i.totalLines)</td>
                <td>@i.insertedCount</td>
                <td>@i.duplicateCount</td>
                <td>@i.errorCount</td>
                <td>@(i.durationMs is not null ? (i.durationMs.Value / 1000.0).ToString("F1") + " s" : "—")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@i.id" class="btn btn-sm btn-outline-primary">Détail</a>
                    @if (i.errorCount > 0)
                    {
                        <a asp-action="Errors" asp-route-id="@i.id" class="btn btn-sm btn-outline-warning">Erreurs</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center">
        <button id="prevBtn" class="btn btn-outline-secondary" disabled>← Précédent</button>
        @if (Model.hasMore && Model.nextCursor is not null)
        {
            <a id="nextBtn" class="btn btn-outline-primary" href="@Url.Action("Index", new { cursor = Model.nextCursor })">Suivant →</a>
        }
        else
        {
            <span class="text-muted">Fin de la liste.</span>
        }
    </div>
}

@section Scripts {
<script>
(function(){
    var stackKey = "importCursorStack";
    var currentCursor = "@(cursor ?? "")";
    var stack = JSON.parse(sessionStorage.getItem(stackKey) || "[]");
    if (currentCursor && stack.length > 0 && stack[stack.length-1] === currentCursor) {
        stack.pop();
        sessionStorage.setItem(stackKey, JSON.stringify(stack));
    }
    var prevBtn = document.getElementById("prevBtn");
    if (prevBtn && stack.length > 0) {
        prevBtn.disabled = false;
        prevBtn.onclick = function() {
            var prev = stack.pop();
            sessionStorage.setItem(stackKey, JSON.stringify(stack));
            var url = new URL(window.location.href);
            if (prev) url.searchParams.set("cursor", prev);
            else url.searchParams.delete("cursor");
            window.location.href = url.toString();
        };
    }
    var nextBtn = document.getElementById("nextBtn");
    if (nextBtn) {
        nextBtn.addEventListener("click", function(e) {
            e.preventDefault();
            if (currentCursor) stack.push(currentCursor);
            sessionStorage.setItem(stackKey, JSON.stringify(stack));
            window.location.href = nextBtn.href;
        });
    }
})();
</script>
}