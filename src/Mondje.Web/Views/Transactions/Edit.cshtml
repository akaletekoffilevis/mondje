@model Mondje.Web.Controllers.EditVm
@{
    ViewData["Title"] = "Modifier la transaction";
}
<h1>Modifier @Model.Id</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3"><label class="form-label">Montant (FCFA)</label><input asp-for="Amount" type="number" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Description (≤255)</label><input asp-for="Description" class="form-control" /></div>
    <button class="btn btn-primary" type="submit">Enregistrer</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Annuler</a>
</form>